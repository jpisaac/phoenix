<datamodel name="WL_IN_LIKE_TABLE_MODEL">
    <datamapping>
        <column>
            <type>CHAR</type>
            <length>1</length>
            <userDefined>true</userDefined>
            <dataSequence>SEQUENTIAL</dataSequence>
            <name>K1</name>
            <valuelist>
                <!-- Distributes according to specified values. These must total 100 -->
                <!-- ["A","B","C","D","E","F","G","H","I","J"] -->
                <datavalue distribution="10">
                    <value>A</value>
                </datavalue>
                <datavalue distribution="10">
                    <value>B</value>
                </datavalue>
                <datavalue distribution="10">
                    <value>C</value>
                </datavalue>
                <datavalue distribution="10">
                    <value>D</value>
                </datavalue>
                <datavalue distribution="10">
                    <value>E</value>
                </datavalue>
                <datavalue distribution="10">
                    <value>F</value>
                </datavalue>
                <datavalue distribution="10">
                    <value>G</value>
                </datavalue>
                <datavalue distribution="10">
                    <value>H</value>
                </datavalue>
                <datavalue distribution="10">
                    <value>I</value>
                </datavalue>
                <datavalue distribution="10">
                    <value>J</value>
                </datavalue>
            </valuelist>
        </column>
        <column>
           <type>VARCHAR</type>
           <length>10</length>
           <userDefined>true</userDefined>
           <dataSequence>SEQUENTIAL</dataSequence>
           <name>K2</name>
        </column>
        <column>
            <type>INTEGER</type>
            <dataSequence>RANDOM</dataSequence>
            <minValue>1</minValue>
            <maxValue>1000000</maxValue>
            <name>CF.A</name>
        </column>
        <column>
           <type>VARCHAR</type>
           <length>50</length>
           <userDefined>true</userDefined>
           <dataSequence>RANDOM</dataSequence>
           <name>CF.B</name>
        </column>
        <column>
           <type>VARCHAR</type>
           <length>50</length>
           <userDefined>true</userDefined>
           <dataSequence>RANDOM</dataSequence>
           <name>CF.C</name>
        </column>
    </datamapping>
    <scenarios>
        <scenario tableName="PHERF.IN_LIKE_TABLE" name="WL_IN_LIKE_TABLE_WRITE" generatorName="WEIGHTED">
            <loadProfile>
                <batchSize>10</batchSize>
                <numOperations>200</numOperations>
                <tenantDistribution id="GLOBAL" weight="100" numTenants="1"></tenantDistribution>
                <opDistribution id="inl_load_1" weight="100"></opDistribution>
            </loadProfile>
            <upserts>
                <upsert id="inl_load_1" useGlobalConnection="true"  upsertGroup="Load"/>
            </upserts>
        </scenario>
        <scenario tableName="PHERF.IN_LIKE_TABLE" name="WL_IN_LIKE_TABLE_READ" generatorName="WEIGHTED">
            <loadProfile>
                <numOperations>50</numOperations>
                <tenantDistribution id="GLOBAL" weight="100" numTenants="1"></tenantDistribution>
                <opDistribution id="inl_1" weight="0"></opDistribution>
                <opDistribution id="inl_2" weight="0"></opDistribution>
                <opDistribution id="inl_3" weight="0"></opDistribution>
                <opDistribution id="inl_4" weight="0"></opDistribution>
                <opDistribution id="inl_5" weight="0"></opDistribution>
            </loadProfile>
            <querySet>
                <query id="inl_1" useGlobalConnection="true" statement="select count(1) from PHERF.IN_LIKE_TABLE where K1 in ('Z', 'D', 'F', 'X')" queryGroup="IN/LIKE Clause"/>
                <query id="inl_2" useGlobalConnection="true" statement="select * from PHERF.IN_LIKE_TABLE where K1 in ('A','B') and K2 in ('xxx1000000','xxx2000000','xxx2000001')" queryGroup="IN/LIKE Clause"/>
                <query id="inl_3" useGlobalConnection="true" statement="select * from PHERF.IN_LIKE_TABLE where K1 in ('A', 'C', 'E', 'F', 'H') and K2 like 'xxxxxx1%'" queryGroup="IN/LIKE Clause"/>
                <query id="inl_4" useGlobalConnection="true" statement="select count(*) from PHERF.IN_LIKE_TABLE where K1 in ('X','A','B','C','D','E','F','G','H','I','J','Z') and K2 like '%1%'" queryGroup="IN/LIKE Clause"/>
                <query id="inl_5" useGlobalConnection="true" statement="select count(*) from PHERF.IN_LIKE_TABLE where (K1 in ('A','E','F','G','H','I','Z') or K1 like 'E%') and (K2 like '%xx1%' or K2 like '%xxxxxx2%')" queryGroup="IN/LIKE Clause"/>
            </querySet>
        </scenario>
    </scenarios>
</datamodel>

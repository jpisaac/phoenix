                <ddl useGlobalConnection="true" statement="CREATE INDEX IF NOT EXISTS ids4 ON PHERF.INDEXED_TABLE (CORE,DB,ACTIVE_VISITOR) SALT_BUCKETS=16" />"
            </preScenarioDdls>

            <querySet>
                <query id="imm_1" useGlobalConnection="true" statement="select count(*) from PHERF.INDEXED_TABLE" queryGroup="Index"/>
                <query id="imm_2" useGlobalConnection="true" statement="select /*+ INDEX(PHERF.INDEXED_TABLE  idx1 idx2 idx3 idx4) */ count(*) from PHERF.INDEXED_TABLE" queryGroup="Index"/>
                <query id="imm_3" useGlobalConnection="true" statement="select /*+ INDEX(PHERF.INDEXED_TABLE  ids1 ids2 ids3 ids4) */ count(*) from PHERF.INDEXED_TABLE" queryGroup="Index"/>
                <query id="imm_4" useGlobalConnection="true" statement="select /*+NO_INDEX*/ count(*) from PHERF.INDEXED_TABLE" queryGroup="Index"/>
                <query id="imm_5" useGlobalConnection="true" statement="select round(date, 'day',50), sum(core)+2 from PHERF.INDEXED_TABLE where (CORE &lt; 10 or CORE &gt; 90) group by round(date, 'day',50), host" queryGroup="Index"/>
                <query id="imm_6" useGlobalConnection="true" statement="select /*+NO_INDEX*/ round(date, 'day',50), sum(core)+2 from PHERF.INDEXED_TABLE where (CORE &lt; 10 or CORE &gt; 90) group by round(date, 'day',50), host" queryGroup="Index"/>
                <query id="imm_7" useGlobalConnection="true" statement="select count(core) from PHERF.INDEXED_TABLE where core IN (1,100)" queryGroup="Index"/>
                <query id="imm_8" useGlobalConnection="true" statement="select /*+ INDEX(PHERF.INDEXED_TABLE  idx1 idx2 idx3 idx4) */ count(core) from PHERF.INDEXED_TABLE where core IN (1,100)" queryGroup="Index"/>
                <query id="imm_9" useGlobalConnection="true" statement="select /*+ INDEX(PHERF.INDEXED_TABLE  ids1 ids2 ids3 ids4) */ count(core) from PHERF.INDEXED_TABLE where core IN (1,100)" queryGroup="Index"/>
                <query id="imm_11" useGlobalConnection="true" statement="select /*+NO_INDEX*/ count(core) from PHERF.INDEXED_TABLE where core IN (1,100)" queryGroup="Index"/>
                <query id="imm_11" useGlobalConnection="true" statement="select count(core) from PHERF.INDEXED_TABLE where core IN (1,25,50,75,100)" queryGroup="Index"/>
                <query id="imm_12" useGlobalConnection="true" statement="select /*+ INDEX(PHERF.INDEXED_TABLE  idx1 idx2 idx3 idx4) */ count(core) from PHERF.INDEXED_TABLE where core IN (1,25,50,75,100)" queryGroup="Index"/>
                <query id="imm_13" useGlobalConnection="true" statement="select /*+ INDEX(PHERF.INDEXED_TABLE  ids1 ids2 ids3 ids4) */ count(core) from PHERF.INDEXED_TABLE where core IN (1,25,50,75,100)" queryGroup="Index"/>
                <query id="imm_14" useGlobalConnection="true" statement="select /*+NO_INDEX*/ count(core) from PHERF.INDEXED_TABLE where core IN (1,25,50,75,100)" queryGroup="Index"/>
                <query id="imm_15" useGlobalConnection="true" statement="select count(core) from PHERF.INDEXED_TABLE where core &lt; 10 and db &lt; 200" queryGroup="Index"/>
                <query id="imm_16" useGlobalConnection="true" statement="select /*+ INDEX(PHERF.INDEXED_TABLE  idx1 idx2 idx3 idx4) */ count(core) from PHERF.INDEXED_TABLE where core &lt; 10 and db &lt; 200" queryGroup="Index"/>
                <query id="imm_17" useGlobalConnection="true" statement="select /*+ INDEX(PHERF.INDEXED_TABLE  ids1 ids2 ids3 ids4) */ count(core) from PHERF.INDEXED_TABLE where core &lt; 10 and db &lt; 200" queryGroup="Index"/>
                <query id="imm_18" useGlobalConnection="true" statement="select /*+NO_INDEX*/ count(core) from PHERF.INDEXED_TABLE where core &lt; 10 and db &lt; 200" queryGroup="Index"/>
                <query id="imm_19" useGlobalConnection="true" statement="select count(core) from PHERF.INDEXED_TABLE where core &lt; 100 and db &lt; 2000" queryGroup="Index"/>
                <query id="imm_20" useGlobalConnection="true" statement="select /*+NO_INDEX*/ count(core) from PHERF.INDEXED_TABLE where core &lt; 100 and db &lt; 2000" queryGroup="Index"/>
                <query id="imm_21" useGlobalConnection="true" statement="select count(core) from PHERF.INDEXED_TABLE where core &gt; 90" queryGroup="Index"/>
                <query id="imm_22" useGlobalConnection="true" statement="select /*+NO_INDEX*/ count(core) from PHERF.INDEXED_TABLE where core &gt; 90" queryGroup="Index"/>
                <query id="imm_23" useGlobalConnection="true" statement="select count(core) from PHERF.INDEXED_TABLE where core &gt; 0" queryGroup="Index"/>
                <query id="imm_24" useGlobalConnection="true" statement="select /*+NO_INDEX*/ count(core) from PHERF.INDEXED_TABLE where core &gt; 0" queryGroup="Index"/>
                <query id="imm_25" useGlobalConnection="true" statement="select db from PHERF.INDEXED_TABLE where db &gt; 5 and db &lt; 7 order by db" queryGroup="Index"/>
                <query id="imm_26" useGlobalConnection="true" statement="select /*+NO_INDEX*/ db from PHERF.INDEXED_TABLE where db &gt; 5 and db &lt; 7 order by db" queryGroup="Index"/>
                <query id="imm_27" useGlobalConnection="true" statement="select db from PHERF.INDEXED_TABLE order by db limit 10" queryGroup="Index"/>
                <query id="imm_28" useGlobalConnection="true" statement="select /*+NO_INDEX*/ db from PHERF.INDEXED_TABLE order by db limit 10" queryGroup="Index"/>
            </querySet>
        </scenario>
    </scenarios>
</datamodel>

<datamodel name="WL_SALTED_TABLE_MODEL">
    <datamapping>
        <column>
            <type>CHAR</type>
            <length>1</length>
            <userDefined>true</userDefined>
            <dataSequence>SEQUENTIAL</dataSequence>
            <name>K1</name>
            <valuelist>
                <!-- Distributes according to specified values. These must total 100 -->
                <!-- ["A","B","C"] -->
                <datavalue distribution="34">
                    <value>A</value>
                </datavalue>
                <datavalue distribution="33">
                    <value>B</value>
                </datavalue>
                <datavalue distribution="33">
                    <value>C</value>
                </datavalue>
            </valuelist>
        </column>
        <column>
           <type>VARCHAR</type>
           <length>10</length>
           <userDefined>true</userDefined>
           <dataSequence>SEQUENTIAL</dataSequence>
           <name>K2</name>
        </column>
        <column>
            <type>VARCHAR</type>
            <length>100</length>
            <userDefined>true</userDefined>
            <dataSequence>RANDOM</dataSequence>
            <name>CFA.A</name>
        </column>
        <column>
           <type>CHAR</type>
           <length>100</length>
           <userDefined>true</userDefined>
           <dataSequence>RANDOM</dataSequence>
           <name>CFA.B</name>
        </column>
        <column>
            <type>INTEGER</type>
            <userDefined>true</userDefined>
            <dataSequence>RANDOM</dataSequence>
            <minValue>1</minValue>
            <maxValue>1000000</maxValue>
            <name>CFA.C</name>
        </column>
        <column>
            <type>INTEGER</type>
            <userDefined>true</userDefined>
            <dataSequence>RANDOM</dataSequence>
            <minValue>1</minValue>
            <maxValue>1000000</maxValue>
            <name>CFB.D</name>
        </column>
    </datamapping>
    <scenarios>
        <scenario tableName="PHERF.SALTED_TABLE" name="WL_SALTED_TABLE_WRITE" generatorName="WEIGHTED">
            <loadProfile>
                <batchSize>10</batchSize>
                <numOperations>200</numOperations>
                <tenantDistribution id="GLOBAL" weight="100" numTenants="1"></tenantDistribution>
                <opDistribution id="slt_load_1" weight="100"></opDistribution>
            </loadProfile>
            <upserts>
                <upsert id="slt_load_1" useGlobalConnection="true" upsertGroup="Load"/>
            </upserts>
        </scenario>
        <scenario tableName="PHERF.SALTED_TABLE" name="WL_SALTED_TABLE_READ" generatorName="WEIGHTED">
            <loadProfile>
                <numOperations>50</numOperations>
                <tenantDistribution id="GLOBAL" weight="100" numTenants="1"></tenantDistribution>
                <opDistribution id="slt_1" weight="0"></opDistribution>
                <opDistribution id="slt_2" weight="0"></opDistribution>
                <opDistribution id="slt_3" weight="0"></opDistribution>
            </loadProfile>
            <querySet>
                <query id="slt_1" useGlobalConnection="true" statement="select count(1) from PHERF.SALTED_TABLE where K1 in ('A', 'B', 'C', 'D')" queryGroup="Salting"/>
                <query id="slt_2" useGlobalConnection="true" statement="select count(*) from PHERF.SALTED_TABLE where D &lt; 1000" queryGroup="Salting"/>
                <query id="slt_3" useGlobalConnection="true" statement="select avg(c),avg(d) from PHERF.SALTED_TABLE group by K1" queryGroup="Salting"/>
            </querySet>
        </scenario>
    </scenarios>
</datamodel>

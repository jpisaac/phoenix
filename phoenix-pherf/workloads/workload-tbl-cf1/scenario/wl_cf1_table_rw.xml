<datamodel name="WL_TABLE_1CF_MODEL">
    <datamapping>
        <column>
            <type>CHAR</type>
            <length>1</length>
            <userDefined>true</userDefined>
            <dataSequence>SEQUENTIAL</dataSequence>
            <name>K1</name>
            <valuelist>
                <!-- Distributes according to specified values. These must total 100 -->
                <!-- ["A","B","C","D"] -->
                <datavalue distribution="25">
                    <value>A</value>
                </datavalue>
                <datavalue distribution="25">
                    <value>B</value>
                </datavalue>
                <datavalue distribution="25">
                    <value>C</value>
                </datavalue>
                <datavalue distribution="25">
                    <value>D</value>
                </datavalue>
            </valuelist>
        </column>
        <column>
           <type>VARCHAR</type>
           <length>10</length>
           <userDefined>true</userDefined>
           <dataSequence>SEQUENTIAL</dataSequence>
           <name>K2</name>
        </column>
        <column>
            <type>INTEGER</type>
            <userDefined>true</userDefined>
            <dataSequence>RANDOM</dataSequence>
            <minValue>1</minValue>
            <maxValue>100</maxValue>
            <name>CF.A</name>
        </column>
        <column>
            <type>INTEGER</type>
            <userDefined>true</userDefined>
            <dataSequence>RANDOM</dataSequence>
            <minValue>1</minValue>
            <maxValue>1000</maxValue>
            <name>CF.B</name>
        </column>
        <column>
            <type>INTEGER</type>
            <userDefined>true</userDefined>
            <dataSequence>RANDOM</dataSequence>
            <minValue>1</minValue>
            <maxValue>2000</maxValue>
            <name>CF.C</name>
        </column>
        <column>
            <type>INTEGER</type>
            <userDefined>true</userDefined>
            <dataSequence>RANDOM</dataSequence>
            <minValue>1</minValue>
            <maxValue>5000</maxValue>
            <name>CF.D</name>
        </column>
        <column>
            <type>INTEGER</type>
            <userDefined>true</userDefined>
            <dataSequence>RANDOM</dataSequence>
            <minValue>1</minValue>
            <maxValue>10000</maxValue>
            <name>CF.E</name>
        </column>
        <column>
            <type>INTEGER</type>
            <userDefined>true</userDefined>
            <dataSequence>RANDOM</dataSequence>
            <minValue>1</minValue>
            <maxValue>15000</maxValue>
            <name>CF.F</name>
        </column>
    </datamapping>
    <scenarios>
        <scenario tableName="PHERF.TABLE_1CF" name="WL_TABLE_1CF_WRITE" generatorName="WEIGHTED">
            <loadProfile>
                <batchSize>10</batchSize>
                <numOperations>200</numOperations>
                <tenantDistribution id="GLOBAL" weight="100" numTenants="1"></tenantDistribution>
                <opDistribution id="cf1_load_1" weight="100"></opDistribution>
            </loadProfile>

            <upserts>
                <upsert id="cf1_load_1" useGlobalConnection="true" upsertGroup="Load"/>
            </upserts>
        </scenario>
        <scenario tableName="PHERF.TABLE_1CF" name="WL_TABLE_1CF_READ" generatorName="WEIGHTED">
            <loadProfile>
                <numOperations>50</numOperations>
                <tenantDistribution id="GLOBAL" weight="100" numTenants="1"></tenantDistribution>
                <opDistribution id="cf1_1" weight="0"></opDistribution>
                <opDistribution id="cf1_2" weight="0"></opDistribution>
                <opDistribution id="cf1_3" weight="0"></opDistribution>
                <opDistribution id="cf1_4" weight="0"></opDistribution>
                <opDistribution id="cf1_5" weight="0"></opDistribution>
                <opDistribution id="cf1_6" weight="0"></opDistribution>
                <opDistribution id="cf1_7" weight="0"></opDistribution>
                <opDistribution id="cf1_8" weight="0"></opDistribution>
            </loadProfile>
            <querySet>
                <query id="cf1_1" useGlobalConnection="true" statement="select count(1) from PHERF.TABLE_1CF where K1 in ('A', 'B', 'C', 'D')" queryGroup="ColumnFamilies-Single"/>
                <query id="cf1_2" useGlobalConnection="true" statement="select count(1) from PHERF.TABLE_1CF where K1 in ('A', 'C')" queryGroup="ColumnFamilies-Single"/>
                <query id="cf1_3" useGlobalConnection="true" statement="select count(*) from PHERF.TABLE_1CF where f &lt; 1000" queryGroup="ColumnFamilies-Single"/>
                <query id="cf1_4" useGlobalConnection="true" statement="select a,b,c,d,e,f from PHERF.TABLE_1CF where B &gt; 1000 and B &lt; 2000 and f &gt; 1000 and f &lt; 2000" queryGroup="ColumnFamilies-Single"/>
                <query id="cf1_5" useGlobalConnection="true" statement="select sum(a),sum(b),sum(c),sum(d) from PHERF.TABLE_1CF group by K1" queryGroup="ColumnFamilies-Single"/>
                <query id="cf1_6" useGlobalConnection="true" statement="select count(*) from PHERF.TABLE_1CF group by A" queryGroup="Large Group By"/>
                <query id="cf1_7" useGlobalConnection="true" statement="select count(*) from PHERF.TABLE_1CF group by B" queryGroup="Large Group By"/>
                <query id="cf1_8" useGlobalConnection="true" statement="select count(*) from PHERF.TABLE_1CF where f &lt; 10000" queryGroup="Aggregation with filter no non-pk"/>
            </querySet>
        </scenario>
    </scenarios>
</datamodel>
